# ArcGIS OAuth 2.0 App ID (required)
# Register at: https://developers.arcgis.com/applications/
VITE_ARCGIS_OAUTH_APP_ID=your_oauth_app_id_here

# Web Map item ID for AI orchestrator embeddings (required)
# Create a web map and copy the item ID here
# The web map must have an embeddings-v01.json resource configured.
VITE_WEBMAP_ITEM_ID=your_webmap_item_id_here

# ArcGIS Portal URL (optional, defaults to ArcGIS Online)
VITE_ARCGIS_PORTAL_URL=https://www.arcgis.com

